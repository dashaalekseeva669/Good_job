#include <iostream>
using namespace std;

int main() {
    const int N = 2, M = 3, P = 2;
    
    int A[N][M] = {{1, 2, 3}, {4, 5, 6}};
    int B[M][P] = {{7, 8}, {9, 10}, {11, 12}};
    int C[N][P] = {0};

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < P; j++) {
            for (int k = 0; k < M; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    cout << "Результат:" << endl;
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < P; j++) {
            cout << C[i][j] << " ";
        }
        cout << endl;
    }
    
    return 0;
}
